PORT=3000

# ── Admin panel credentials ───────────────────────────────────
PANEL_USER=admin
PANEL_PASS=change-me

# ── JWT ───────────────────────────────────────────────────────
# Required, min 32 chars. The server refuses to start without it.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Broadcast PIN ─────────────────────────────────────────────
# Second factor for every endpoint that sends a Telegram message
# (/trigger, /channel-broadcast, /sendMessage, /users/:id/message,
#  /pools/:id/announce). The panel asks for it before each send.
# Required — while empty those endpoints reply 503. Min 4 chars.
# 5 wrong attempts per IP per 15 min = locked out.
BROADCAST_PIN=

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated admin panel origins allowed to call this API from a browser.
# Leave empty to allow every origin (development only).
PANEL_ORIGINS=https://panel.mahbet.com,http://localhost:3001

# ── MahBet site integration ───────────────────────────────────
# Shared key the site sends as the x-api-key header to
# /login, /registration and /fraud. Leave empty to keep them open.
SITE_API_KEY=

# ── Telegram ──────────────────────────────────────────────────
BOT_TOKEN=
POSTER_BOT_TOKEN=
MAX_REQUEST_LIMIT=100

# ── Database (knex / MySQL) ───────────────────────────────────
DB_HOST=
DB_USER=
DB_PASS=
DB_DATABASE=
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://127.0.0.1:6379

# ── Bot content / links ───────────────────────────────────────
LOCALE=fa
WEB_APP=
WELCOME_IMAGE_URL=
MAHBET_LOGIN=
MAHBET_REGISTR=

# ── CentralPay automation (withdrawal lookups) ────────────────
# Where the centralpay-automation watcher serves its service API.
# Leave empty to hide the "my last withdrawal" button entirely.
CENTRALPAY_API_URL=http://127.0.0.1:8090
# Must equal ADMIN_SERVICE_TOKEN in centralpay-automation's .env.
CENTRALPAY_API_TOKEN=
# Support handle shown when a lookup fails or an account isn't linked.
SUPPORT_USERNAME=@MB_Support
# How long a player waits after being shown their withdrawal, in minutes.
# Failed lookups never consume it.
CENTRALPAY_LOOKUP_COOLDOWN_MIN=20
